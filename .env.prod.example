# ===== PROJECT INFO =====
PROJECT_NAME=rovno-dev-site
BUILD_TARGET=prod

# ===== SERVER =====
APP_PORT=8080
AUTH_PORT=8081
CASES_PORT=8082
ORDERS_PORT=8083

DB_DRIVER=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=
DB_DSN=${DB_DRIVER}://${DB_USER}:${DB_PASSWORD}@db:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE} 

POSTGRES_PASSWORD="postgres"
PGADMIN_DEFAULT_EMAIL=""
PGADMIN_DEFAULT_PASSWORD="postgres"

# ===== FRONTEND =====
NODE_ENV=production
NEXT_PUBLIC_BASE_URL=https://rovno.dev
FRONTEND_PORT=3000
